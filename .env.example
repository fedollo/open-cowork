# Cursor API key — Dashboard → Integrations
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Local API port (default 8787)
PORT=8787

# --- Optional MCP integrations (enable in the UI sidebar) ---
# Secrets stay in .env only — never committed or sent in session JSON.

# GitHub (official HTTP MCP) — https://github.com/github/github-mcp-server
# Create a PAT: https://github.com/settings/tokens
# Classic (recommended for MCP scope filtering): repo, read:org as needed
# Fine-grained: grant Issues/Pull requests/Contents for the target repos
# GITHUB_TOKEN=your_github_pat_here
# or: GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here

# Atlas Cloud (stdio: npx -y atlascloud-mcp) — https://www.atlascloud.ai
# Only the API key is required for MCP. A base URL is for OpenAI SDK clients,
# not for this integration (MCP talks to Atlas itself).
# ATLASCLOUD_API_KEY=

# Replicate (stdio: npx -y replicate-mcp)
# REPLICATE_API_TOKEN=
