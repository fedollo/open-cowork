{
  "name": "open-loop",
  "private": true,
  "version": "0.1.0",
  "description": "Local agentic workspace UI powered by the Cursor Agent SDK (unofficial)",
  "scripts": {
    "predev": "pnpm --filter @open-loop/shared build",
    "dev": "pnpm -r --parallel --filter @open-loop/api --filter @open-loop/web dev",
    "build": "pnpm -r --filter @open-loop/shared --filter @open-loop/api --filter @open-loop/web build",
    "dev:api": "pnpm --filter @open-loop/api dev",
    "dev:web": "pnpm --filter @open-loop/web dev",
    "restart": "bash scripts/restart.sh",
    "stop": "bash scripts/stop.sh",
    "test": "pnpm --filter @open-loop/api test && tsx --test tests/**/*.test.ts",
    "test:api": "pnpm --filter @open-loop/api test",
    "test:app": "tsx --test tests/**/*.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@9.15.0"
}
